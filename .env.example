# Copy to .env and fill in. .env is gitignored — never commit real values.
# TODO: Securely load these from an environment variable or secrets vault. Do not hardcode.

# --- Model gateway (GoTo Model Garden) -------------------------------------
# Note: no trailing /v1 — the gateway serves /chat/completions directly.
LLM_BASE_URL=
LITELLM_API_KEY=

# --- MinIO (S3-protocol object store) --------------------------------------
# These are boto3's credential variable names, not an AWS dependency.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Scoped credentials for mcp-evidence — refund-evidence/* only
MINIO_EVIDENCE_KEY=
MINIO_EVIDENCE_SECRET=

# --- Per-domain DB roles for the MCP servers (§4A) -------------------------
# `make secrets` fills these with `openssl rand -hex 16` if they are empty, and
# `make migrate` creates the roles with them. No MCP_COMMERCE_PW: mcp-commerce
# holds no database credential at all — it reads through mock-commerce.
MCP_LOG_PW=
MCP_POLICY_PW=

# --- Dashboard accounts (L6) -------------------------------------------------
# reviewer@example.com and admin@example.com. `make secrets` fills these and
# `make migrate` stores only their bcrypt hashes. The browser asks for them at
# /review (HTTP Basic).
REVIEWER_PW=
ADMIN_PW=

# --- Langfuse (self-hosted v2) ---------------------------------------------
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Application secrets ---------------------------------------------------
JWT_SIGNING_KEY=
WEBHOOK_HMAC_SECRET=

# --- Substrate switches ----------------------------------------------------
QUEUE_BACKEND=rabbitmq      # | sqs
OBJECT_BACKEND=minio        # | s3
TOOL_PROVIDER=mcp           # | direct
NOTIFIER=log                # | smtp
MODEL_PROFILE=local         # | cloud
MAX_CONCURRENT_CASES=3
LLM_RATE_LIMIT_RPS=2
# Per-node wall-clock budget, and the collector's own (it makes several model
# calls in a loop). A node that overruns degrades and the case escalates.
NODE_BUDGET_S=240
COLLECTOR_BUDGET_S=600
# Ceiling on the frozen evidence bundle, in bytes of canonical JSON.
BUNDLE_MAX_BYTES=120000

# --- Host port overrides ----------------------------------------------------
# Defaults match PLANNING-LOCAL §8. Override only when something else on your
# machine already holds a port (an SSH tunnel, another Postgres, ...).
# PG_PORT=5432
# RABBIT_PORT=5672
# RABBIT_MGMT_PORT=15672
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# OPA_PORT=8181
# MOCK_PORT=8010
# The MCP servers all listen on 9101 internally; these are host ports only, so
# that mcp-commerce can be opened by hand from Claude Desktop.
# MCP_COMMERCE_PORT=9101
# MCP_EVIDENCE_PORT=9102
# MCP_POLICY_PORT=9103
